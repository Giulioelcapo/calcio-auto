# === Obbligatori per dati reali ===
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_TOKEN=

# === Sondaggio globale (obbligatorio su Vercel) ===
# Free: https://console.upstash.com → Create Database → REST API
# Senza queste, i voti non sono condivisi tra utenti/paesi sul deploy.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# === Sito pubblico (dopo deploy) ===
NEXT_PUBLIC_SITE_URL=https://calcio-auto.vercel.app

# Email mostrata in Contatti / Privacy (usa un’email reale)
NEXT_PUBLIC_CONTACT_EMAIL=tua-email@dominio.it

# === Google Search Console (opzionale) ===
# Codice meta tag HTML: content="...." da Search Console → Verifica proprietà
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# === Google AdSense (solo se/quando approvato) ===
# Es: ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_SIDE=
NEXT_PUBLIC_ADSENSE_SLOT_INCONTENT=

# === Partner / affiliate (funziona SENZA AdSense) ===
# Se vuoti, gli slot mostrano “Spazio partner” → /contatti
NEXT_PUBLIC_PARTNER_TOP_URL=
NEXT_PUBLIC_PARTNER_TOP_TITLE=
NEXT_PUBLIC_PARTNER_SIDE_URL=
NEXT_PUBLIC_PARTNER_SIDE_TITLE=
NEXT_PUBLIC_PARTNER_INCONTENT_URL=
NEXT_PUBLIC_PARTNER_INCONTENT_TITLE=
